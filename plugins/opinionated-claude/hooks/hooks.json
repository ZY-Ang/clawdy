{
  "description": "Refuse to end a turn that asks permission for implied work, announces work instead of doing it, or cites work by bare number instead of a link.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/no-permission-asking",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/no-announced-work",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/no-bare-refs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
