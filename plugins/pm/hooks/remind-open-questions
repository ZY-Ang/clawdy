#!/bin/sh
# UserPromptSubmit: when the human speaks and a question is open, say so.
#
# The failure this exists for is not disagreement. An agent asks something,
# the human answers in chat, the agent replies "noted" — and writes nothing
# down. It is not refusing; nothing ever checked, so nothing ever happened.
#
# This fires at the one moment that matters: the turn where the answer arrives.
# Its stdout is injected into the model's context, so the reminder is read
# before the reply is composed rather than after.
#
# It reminds; it does not block. The agent cannot reliably tell whether a given
# message answered the question or changed the subject, so a hook that refused
# to let the turn end would stop the wrong turns and get switched off. A
# reminder naming the exact command survives contact.
#
# Plain stdout, not JSON. `additionalContext` in a JSON payload is reported
# broken in the VSCode extension while working in the CLI (anthropics/
# claude-code#49063); stdout injection works in both, and the workbench this
# was written for is VSCode-based.
#
# UserPromptSubmit blocks the turn until it returns and times out at 30s, so
# this does one directory listing and nothing else. No network, no gh.

QUESTIONS_DIR=${CLAUDE_QUESTIONS_DIR:-$HOME/.claude/questions}
SESSION=${CLAUDE_CODE_SESSION_ID:-${CLAUDE_SESSION_ID:-}}

# Silence is the common case and must cost nothing.
[ -d "$QUESTIONS_DIR" ] || exit 0

# Only this session's questions. Another agent's open question is not something
# this human is answering right now, and naming it would be noise.
#
# With no session id every agent shares `unsessioned`, so the list is NOT this
# session's -- it is everyone's. The reminder says so rather than presenting
# another agent's questions as work this one owes.
DIR="$QUESTIONS_DIR/${SESSION:-unsessioned}"
SCOPED=1; [ -n "${SESSION:-}" ] || SCOPED=0
[ -d "$DIR" ] || exit 0

# The prompt's own session id keys what this session was last shown; the env id
# can be absent, and a shared `unsessioned` key would hide the list from all but
# the first agent to see it.
INPUT=""; [ -t 0 ] || INPUT=$(cat 2>/dev/null || true)
KEY=$(printf '%s' "$INPUT" | sed -n 's/.*"session_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
[ -n "$KEY" ] || KEY=${SESSION:-}
KEY=$(printf '%s' "$KEY" | tr -cd 'A-Za-z0-9._-')
SHOWN=""; [ -n "$KEY" ] && SHOWN="$DIR/.reminded.$KEY"

n=0
ids=""
out=""
for f in "$DIR"/*.md; do
  [ -f "$f" ] || continue
  st=$(sed -n 's/^- status: //p' "$f" 2>/dev/null | head -1)
  [ -n "$st" ] || st=open
  [ "$st" = open ] || continue
  # Tasks are filed, not answered; only questions wait on the human.
  [ "$(sed -n 's/^- kind: //p' "$f" 2>/dev/null | head -1)" = task ] && continue
  id=$(sed -n 's/^- id: //p' "$f" 2>/dev/null | head -1)
  title=$(sed -n '1s/^# //p' "$f" 2>/dev/null | sed 's/^\(.\{69\}\)..*$/\1…/')
  [ -n "$id" ] || continue
  n=$((n + 1))
  ids="$ids$id
"
  out="$out
  $id  $title"
done

# Ids shown last time that are no longer open, so a resolved one is named once
# rather than vanishing.
gone=""
if [ -n "$SHOWN" ] && [ -f "$SHOWN" ]; then
  while IFS= read -r old; do
    [ -n "$old" ] || continue
    case "
$ids" in *"
$old
"*) ;; *) gone="$gone $old" ;; esac
  done < "$SHOWN"
fi

if [ "$n" -eq 0 ]; then
  [ -n "$SHOWN" ] && rm -f "$SHOWN"
  [ -n "$gone" ] && echo "[open questions] None open now; no longer open since the last list:$gone"
  exit 0
fi

# Unchanged since the full list was printed: one line, not the list again.
if [ -n "$SHOWN" ] && [ -f "$SHOWN" ] && [ "$(cat "$SHOWN")" = "$(printf '%s' "$ids")" ]; then
  echo "[open questions] $n still open, listed earlier (\`questions\` lists them). If this message answers one, record it BEFORE replying: questions answer <id> \"<what the human said>\""
  exit 0
fi
[ -n "$SHOWN" ] && printf '%s' "$ids" > "$SHOWN" 2>/dev/null

# Written as an instruction rather than a status line: a status line is read as
# background and skipped, and being skipped is the whole problem.
# Computed here, not branched inside the heredoc: a heredoc is text, so an `if`
# written in one is printed rather than evaluated -- which is how the first
# attempt at this looked correct and did nothing.
if [ "$SCOPED" -eq 1 ]; then
  WHOSE="in this session"
else
  WHOSE="with no session id — these are shared with every other unscoped agent, so some may not be yours"
fi

GONE=""; [ -n "$gone" ] && GONE="
No longer open since the last list:$gone
"

cat <<MSG
[open questions] You asked $n question(s) $WHOSE that are still open:
$out
$GONE
If the message you are about to answer resolves one, record it BEFORE replying
(not after, not "noted"); the answer is appended to the question's note:
  questions answer <id> "<what the human actually said>"
Overtaken by events: questions close <id> --reason superseded
Otherwise ignore this. The full list is repeated only when it changes.
MSG
exit 0
